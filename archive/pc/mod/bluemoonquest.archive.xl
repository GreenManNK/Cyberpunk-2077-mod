      parent: mod\quest\newgameplus_q001.quest
    - path: mod\blue_ra\quest\blue_ra_run.questphase
      parent: mod\quest\newgameplus_standalone.quest
    - path: mod\ra_bluemoon_hangout_v11\quest\phases\mq055_apartment.questphase
