        ArrayPush(arr, t"AttachmentSlots.Smart_AR_SMG_LMG_WeaponMod5");
        ArrayPush(arr, t"AttachmentSlots.Smart_AR_SMG_LMG_WeaponMod6");
        ArrayPush(arr, t"AttachmentSlots.GenericWeaponMod1");
        ArrayPush(arr, t"AttachmentSlots.GenericWeaponMod2");
        ArrayPush(arr, t"AttachmentSlots.GenericWeaponMod3");
        ArrayPush(arr, t"AttachmentSlots.GenericWeaponMod4");
        ArrayPush(arr, t"AttachmentSlots.GenericWeaponMod5");
        ArrayPush(arr, t"AttachmentSlots.GenericWeaponMod6");
        return arr;
