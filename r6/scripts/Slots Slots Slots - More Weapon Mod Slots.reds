        ArrayPush(arr, t"AttachmentSlots.Power_AR_SMG_LMG_WeaponMod4");
        ArrayPush(arr, t"AttachmentSlots.Power_AR_SMG_LMG_WeaponMod5");
        ArrayPush(arr, t"AttachmentSlots.Power_AR_SMG_LMG_WeaponMod6");
        ArrayPush(arr, t"AttachmentSlots.Tech_AR_SMG_LMG_WeaponMod3");
        ArrayPush(arr, t"AttachmentSlots.Tech_AR_SMG_LMG_WeaponMod4");
        ArrayPush(arr, t"AttachmentSlots.Tech_AR_SMG_LMG_WeaponMod5");
        ArrayPush(arr, t"AttachmentSlots.Tech_AR_SMG_LMG_WeaponMod6");
