        ArrayPush(arr, t"AttachmentSlots.Smart_Precision_Sniper_Rifle_WeaponMod3");
        ArrayPush(arr, t"AttachmentSlots.Smart_Precision_Sniper_Rifle_WeaponMod4");
        ArrayPush(arr, t"AttachmentSlots.Smart_Precision_Sniper_Rifle_WeaponMod5");
