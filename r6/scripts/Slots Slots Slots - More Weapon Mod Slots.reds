        ArrayPush(arr, t"AttachmentSlots.Power_Precision_Sniper_Rifle_WeaponMod3");
        ArrayPush(arr, t"AttachmentSlots.Power_Precision_Sniper_Rifle_WeaponMod4");
        ArrayPush(arr, t"AttachmentSlots.Power_Precision_Sniper_Rifle_WeaponMod5");
        ArrayPush(arr, t"AttachmentSlots.Power_Precision_Sniper_Rifle_WeaponMod6");
