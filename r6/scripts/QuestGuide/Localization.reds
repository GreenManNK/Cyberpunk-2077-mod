    this.Text("Mod-QuestGuide-Hint-GoTracked", "Tracked quest");
    this.Text("Mod-QuestGuide-Hint-Section", "Section");
    this.Text("Mod-QuestGuide-Hint-Filters", "Filters");
  }
}

