  protected cb func OnTipClicked(evt: ref<inkPointerEvent>) -> Bool {
  evt.Consume();

  let player: ref<PlayerPuppet> = this.m_deviceLogicController.GetPlayerControlledObject() as PlayerPuppet;  // ← browser controller method
  if !IsDefined(player) {
    return true;
  }

  let gi = player.GetGame();
  let ts = GameInstance.GetTransactionSystem(gi);

  let itemID = ItemID.FromTDBID(t"Items.money");
  ts.GiveItem(player, itemID, -50);
  return true;
}

