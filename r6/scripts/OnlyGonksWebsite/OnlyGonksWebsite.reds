  private let tipclicked1: ref<inkImage>;

  protected cb func OnTipClick1(widget: wref<inkWidget>) -> Bool {
    this.tipclicked1.SetOpacity(0.2);
    
    let delaySystem = GameInstance.GetDelaySystem(this.m_deviceLogicController.GetPlayerControlledObject().GetGame());
    let callback = new SimpleOpacityResetCallback();
    callback.image = this.tipclicked1;
    delaySystem.DelayCallback(callback, 0.15);
  }

  protected cb func ResetTipOpacity() -> Void {
    this.tipclicked1.SetOpacity(1.0);
  }

