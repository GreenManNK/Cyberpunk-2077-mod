public class SimpleOpacityResetCallback extends DelayCallback {
  public let image: ref<inkImage>;

  public func Call() -> Void {
    if IsDefined(this.image) {
      this.image.SetOpacity(1.0);
    }
  }
}

@addField(BrowserGameController)
private let m_onlyGonksListener: ref<OnlyGonksListener>;

@wrapMethod(BrowserGameController)
protected cb func OnInitialize() -> Bool {
  wrappedMethod();
  this.m_onlyGonksListener = new OnlyGonksListener();
  this.m_onlyGonksListener.Init(this);
}

@wrapMethod(BrowserGameController)
protected cb func OnUninitialize() -> Bool {
  wrappedMethod();
  if IsDefined(this.m_onlyGonksListener) {
    this.m_onlyGonksListener.Uninit();
  }
  this.m_onlyGonksListener = null;
}