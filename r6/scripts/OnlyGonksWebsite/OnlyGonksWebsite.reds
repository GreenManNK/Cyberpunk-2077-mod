  public func Init(logic: ref<BrowserGameController>) {
    super.Init(logic);
    this.m_siteData.address = s"NETdir://only.gonks";
    this.m_siteData.shortName = s"OnlyGonks";
    this.m_siteData.iconAtlasPath = r"base\\gameplay\\gui\\world\\internet\\templates\\atlases\\onlygonkslogo.inkatlas";
    this.m_siteData.iconTexturePart = n"icon";
  }

  public func Uninit() {
    super.Uninit();
  }

  public func GetWebPage(address: String) -> ref<inkWidget> {
    let canvas = new inkCanvas();

    // Login
    if Equals(address, s"NETdir://only.gonks") {
      let canvas = new inkCanvas();
      let vPanel = new inkVerticalPanel();
      vPanel.SetMargin(new inkMargin(0.0, 40.0, 0.0, 0.0));
      vPanel.SetAnchor(inkEAnchor.TopCenter);
      vPanel.SetAnchorPoint(0.5, 0.0);
      vPanel.SetFitToContent(true);
      vPanel.SetChildMargin(new inkMargin(0.0, 20.0, 0.0, 20.0));
      vPanel.Reparent(canvas);

      let welcome = new inkImage();
      welcome.SetAtlasResource(r"base\\gameplay\\gui\\world\\internet\\templates\\atlases\\onlygonkswelcome.inkatlas");
      welcome.SetTexturePart(n"onlygonkswelcome");
      welcome.SetSize(new Vector2(1200.0, 700.0));
      welcome.SetHAlign(inkEHorizontalAlign.Center);
      welcome.SetVAlign(inkEVerticalAlign.Center);
      welcome.SetAnchorPoint(0.5, 0.5);
      welcome.SetMargin(new inkMargin(1556.0, 500.0, 0.0, 0.0));
      welcome.SetInteractive(true);
      welcome.RegisterToCallback(n"OnClick", this, n"OnWelcomeClicked");
      welcome.Reparent(canvas);

      let username = new inkImage();
      username.SetAtlasResource(r"base\\gameplay\\gui\\world\\internet\\templates\\atlases\\onlygonksuserempty.inkatlas");
      username.SetTexturePart(n"onlygonksuserempty");
      username.SetSize(new Vector2(1000.0, 300.0));
      username.SetHAlign(inkEHorizontalAlign.Center);
      username.SetVAlign(inkEVerticalAlign.Center);
      username.SetAnchorPoint(0.5, 0.5);
      username.SetMargin(new inkMargin(1500.0, 950.0, 0.0, 0.0));
      username.SetInteractive(true);
      username.RegisterToCallback(n"OnClick", this, n"OnUsernameClicked");
      username.Reparent(canvas);

      let password = new inkImage();
      password.SetAtlasResource(r"base\\gameplay\\gui\\world\\internet\\templates\\atlases\\onlygonkspasswordempty.inkatlas");
      password.SetTexturePart(n"onlygonkspasswordempty");
      password.SetSize(new Vector2(1000.0, 300.0));
      password.SetHAlign(inkEHorizontalAlign.Center);
      password.SetVAlign(inkEVerticalAlign.Center);
      password.SetAnchorPoint(0.5, 0.5);
      password.SetMargin(new inkMargin(1500.0, 1050.0, 0.0, 0.0));
      password.Reparent(canvas);

      let upperLine = new inkRectangle();
      upperLine.SetTintColor(new HDRColor(1.0, 0.4, 0.8, 1.0));
      upperLine.SetOpacity(0.85);
      upperLine.SetSize(new Vector2(3130.0, 5.0));
      upperLine.SetMargin(new inkMargin(5.0, 0.0, 0.0, 0.0));
      upperLine.SetHAlign(inkEHorizontalAlign.Center);
      upperLine.Reparent(canvas);

      let upperLine = new inkRectangle();
      upperLine.SetTintColor(new HDRColor(1.0, 0.4, 0.8, 1.0));
      upperLine.SetOpacity(0.85);
      upperLine.SetSize(new Vector2(3130.0, 5.0));
      upperLine.SetMargin(new inkMargin(5.0, 30.0, 0.0, 0.0));
      upperLine.SetHAlign(inkEHorizontalAlign.Center);
      upperLine.Reparent(canvas);

      let upperLine = new inkRectangle();
      upperLine.SetTintColor(new HDRColor(0.2, 1.0, 1.0, 1.0));
      upperLine.SetOpacity(0.85);
      upperLine.SetSize(new Vector2(3130.0, 5.0));
      upperLine.SetMargin(new inkMargin(5.0, 130.0, 0.0, 0.0));
      upperLine.SetHAlign(inkEHorizontalAlign.Center);
      upperLine.Reparent(canvas);

      let upperLine = new inkRectangle();
      upperLine.SetTintColor(new HDRColor(0.2, 1.0, 1.0, 1.0));
      upperLine.SetOpacity(0.85);
      upperLine.SetSize(new Vector2(3130.0, 5.0));
      upperLine.SetMargin(new inkMargin(5.0, 150.0, 0.0, 0.0));
      upperLine.SetHAlign(inkEHorizontalAlign.Center);
      upperLine.Reparent(canvas);

      let upperLine = new inkRectangle();
      upperLine.SetTintColor(new HDRColor(1.0, 0.4, 0.8, 1.0));
      upperLine.SetOpacity(0.85);
      upperLine.SetSize(new Vector2(3130.0, 5.0));
      upperLine.SetMargin(new inkMargin(5.0, 1170.0, 0.0, 0.0));
      upperLine.SetHAlign(inkEHorizontalAlign.Center);
      upperLine.Reparent(canvas);

      let upperLine = new inkRectangle();
      upperLine.SetTintColor(new HDRColor(1.0, 0.4, 0.8, 1.0));
      upperLine.SetOpacity(0.85);
      upperLine.SetSize(new Vector2(3130.0, 5.0));
      upperLine.SetMargin(new inkMargin(5.0, 1230.0, 0.0, 0.0));
      upperLine.SetHAlign(inkEHorizontalAlign.Center);
      upperLine.Reparent(canvas);

      return canvas;
    }

    // Username
    if Equals(address, s"NETdir://only.gonks/username") {
      let canvas = new inkCanvas();
      let vPanel = new inkVerticalPanel();
      vPanel.SetMargin(new inkMargin(0.0, 40.0, 0.0, 0.0));
      vPanel.SetAnchor(inkEAnchor.TopCenter);
      vPanel.SetAnchorPoint(0.5, 0.0);
      vPanel.SetFitToContent(true);
      vPanel.SetChildMargin(new inkMargin(0.0, 20.0, 0.0, 20.0));
      vPanel.Reparent(canvas);

      let welcome = new inkImage();
      welcome.SetAtlasResource(r"base\\gameplay\\gui\\world\\internet\\templates\\atlases\\onlygonkswelcome.inkatlas");
      welcome.SetTexturePart(n"onlygonkswelcome");
      welcome.SetSize(new Vector2(1200.0, 700.0));
      welcome.SetHAlign(inkEHorizontalAlign.Center);
      welcome.SetVAlign(inkEVerticalAlign.Center);
      welcome.SetAnchorPoint(0.5, 0.5);
      welcome.SetMargin(new inkMargin(1556.0, 500.0, 0.0, 0.0));
      welcome.Reparent(canvas);

      let username = new inkImage();
      username.SetAtlasResource(r"base\\gameplay\\gui\\world\\internet\\templates\\atlases\\onlygonksusernamefill.inkatlas");
      username.SetTexturePart(n"onlygonksusernamefill");
      username.SetSize(new Vector2(1000.0, 300.0));
      username.SetHAlign(inkEHorizontalAlign.Center);
      username.SetVAlign(inkEVerticalAlign.Center);
      username.SetAnchorPoint(0.5, 0.5);
      username.SetMargin(new inkMargin(1500.0, 950.0, 0.0, 0.0));
      username.SetInteractive(false);
      username.RegisterToCallback(n"OnClick", this, n"OnUsernameClicked");
      username.Reparent(canvas);

      let password = new inkImage();
      password.SetAtlasResource(r"base\\gameplay\\gui\\world\\internet\\templates\\atlases\\onlygonkspasswordempty.inkatlas");
      password.SetTexturePart(n"onlygonkspasswordempty");
      password.SetSize(new Vector2(1000.0, 300.0));
      password.SetHAlign(inkEHorizontalAlign.Center);
      password.SetVAlign(inkEVerticalAlign.Center);
      password.SetAnchorPoint(0.5, 0.5);
      password.SetMargin(new inkMargin(1500.0, 1050.0, 0.0, 0.0));
