// Ket_CivilStealthKill
// Enables stealth takedowns, quickhacking, and carrying on civilian NPCs
// No loot modifications - civilians drop nothing extra

package Character
using RTDB, BaseStats, Crowds, Ability, Perks

// Base crowd NPC - enable grapple, takedowns, quickhacks, and carrying
Crowd_NPC_Base : NPC_Base
{
    fk< ObjectAction >[] objectActions = 
    [
        "GenericInteraction.PickUpBody", 
        "GenericInteraction.Talk", 
        "GenericInteraction.ReturnTalk", 
        "Takedown.Grapple", 
